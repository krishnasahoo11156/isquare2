APP_NAME=iSquare
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./isquare.db
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10
FRONTEND_ORIGIN=http://localhost:3000
# Allowed frontend origins for CORS (comma-separated).
# Defaults to: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ANALYSIS_MAX_DIMENSION=2400
ISQUARE_OCR_LANGUAGE=eng
# Optional full path when Tesseract is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
MODEL_CACHE_DIR=./storage/models
ANALYSIS_WORKER_POLL_SECONDS=2
ANALYSIS_WORKER_LEASE_SECONDS=900
ANALYSIS_WORKER_MAX_ATTEMPTS=2
ISQUARE_OCR_TIMEOUT_SECONDS=120
